# Copy to backend/.env. Only OPENAI_API_KEY is needed to run the agent locally;
# everything else has a fake or a safe default.

# ---- Runtime ---------------------------------------------------------------
# dev | test | prod. Unset means prod. dev enables POST /dev/* endpoints and unsigned webhooks.
CASELOOP_ENV=dev
CASELOOP_BASE_URL=http://localhost:8000
# Local Homebrew Postgres (no password). Docker Compose users: postgresql+asyncpg://postgres:postgres@localhost:5432/caseloop
CASELOOP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/caseloop
# Where attachments are stored.
CASELOOP_DATA_DIR=./data

# ---- Agent brain -----------------------------------------------------------
# openai | scripted (scripted = deterministic rules, no LLM; used by tests and `make demo`)
CASELOOP_AGENT_RUNNER=openai
OPENAI_API_KEY=sk-proj-...
CASELOOP_OPENAI_MODEL=gpt-5.5
# Cheaper model for classification, extraction, and insights reports.
CASELOOP_OPENAI_FAST_MODEL=gpt-5.4-mini

# ---- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...

# ---- SMS + voice (Dial, getdial.ai) ----------------------------------------
DIAL_API_KEY=sk_live_...
DIAL_WEBHOOK_SECRET=whsec_...
